    "persona.mjs",
    "state-sim.mjs",
    "state-store.mjs",
    "state-controller.mjs",
    "logged-simulator.mjs",
    "manage.mjs",
    "model-selection.mjs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "DEVICE-PROBE-02.md",
    "locale",
    "client.js"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3 <0.2.2"
  },
  "packageManager": "pnpm@11.28.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GolfMilk1029/Dsh-story-continuity.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.2.2",
